+/** A due refresh stays due when the loader is busy or disconnected. */
+export function createQuotaRefreshController(options: {
+  now: () => number;
+  ready: () => boolean;
+  refresh: () => Promise<boolean>;
+}) {
+  let lastStartedAt: number | null = null;
+  let running = false;
+  let generation = 0;
+
+  return {
+    invalidate() {
+      generation += 1;
+      lastStartedAt = null;
+    },
+    async check(): Promise<void> {
+      const now = options.now();
+      if (running || !options.ready()) return;
+      if (lastStartedAt !== null && now >= lastStartedAt &&
+          now - lastStartedAt < QUOTA_AUTO_REFRESH_MS) return;
+      running = true;
+      const requestGeneration = generation;
+      try {
+        const accepted = await options.refresh();
+        if (accepted && requestGeneration === generation) lastStartedAt = now;
+      } catch {
+        // Provider errors are displayed by the loader. An unexpected failure
+        // must not disable subsequent automatic attempts or reject an event handler.
+        if (requestGeneration === generation) lastStartedAt = now;
+      } finally {
+        running = false;
+      }
+    },
+  };
+}
