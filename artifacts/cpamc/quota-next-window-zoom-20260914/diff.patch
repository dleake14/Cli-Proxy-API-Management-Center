diff --git a/src/features/quota/quotaTimelineModel.ts b/src/features/quota/quotaTimelineModel.ts
index 5df32e1..7f84e34 100644
--- a/src/features/quota/quotaTimelineModel.ts
+++ b/src/features/quota/quotaTimelineModel.ts
@@ -921,8 +921,12 @@ export function zoomCurrentSpan(
   visibleDays: number
 ): { startMs: number; endMs: number; days: number } {
   const days = clampTimelineZoomDays(mode, visibleDays);
-  const fraction = Math.max(0, Math.min(1, (now - span.startMs) / (span.endMs - span.startMs)));
-  const startMs = startOfDay(now - fraction * days * DAY_MS);
+  // Anchor the left edge at the start of today. The fit span begins at the
+  // current window's open, which can sit days in the past; re-centring on `now`
+  // kept that past history on screen, so zooming out replayed earlier days and
+  // pushed the next subscription runs off the right edge. Pinning the left edge
+  // to today means a wider range adds future time instead.
+  const startMs = Math.max(startOfDay(now), startOfDay(span.startMs));
   return { startMs, endMs: addCalendarDays(startMs, days), days };
 }
 
