+  test('zooming out extends into the future instead of replaying past days', () => {
+    const lane: TimelineLane = { name: 'Claude', displayName: 'Claude', provider: 'claude',
+      anchorMs: reset, periodHours: 168, remaining: 85, limits: [], resetCredits: [] };
+    const fitted = currentWindowSpan([lane], now, 15);
+    const narrow = zoomCurrentSpan(fitted, now, 'weekly', 7);
+    const wide = zoomCurrentSpan(fitted, now, 'weekly', 30);
+
+    // Left edge is pinned to today, not to a fraction of the old span.
+    expect(narrow.startMs).toBe(startOfDay(now));
+    expect(wide.startMs).toBe(narrow.startMs);
+    // Every extra day lands to the right, so the future windows stay on screen.
+    expect(wide.endMs).toBeGreaterThan(narrow.endMs);
+    expect(projectLane(lane, narrow.startMs, narrow.endMs, now, 'weekly')
+      .filter((w) => w.state === 'next').length)
+      .toBeLessThan(projectLane(lane, wide.startMs, wide.endMs, now, 'weekly')
+        .filter((w) => w.state === 'next').length);
+  });
