index 0000000..73fe9cd
--- /dev/null
+++ b/tests_py/test_refresh_muse_quota.py
@@ -0,0 +1,33 @@
+import importlib.util
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+
+
+SCRIPT = Path(__file__).parents[1] / "scripts" / "refresh_muse_quota.py"
+SPEC = importlib.util.spec_from_file_location("refresh_muse_quota", SCRIPT)
+assert SPEC and SPEC.loader
+refresh_muse_quota = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(refresh_muse_quota)
+
+
+def test_failed_refresh_marks_existing_sidecar_stale(tmp_path, monkeypatch):
+    sidecar = tmp_path / "muse-usage.json"
+    monkeypatch.setattr(refresh_muse_quota, "SIDECAR", sidecar)
+    now = datetime(2026, 9, 18, 12, 0, tzinfo=timezone.utc)
+    payload = {
+        "ok": True,
+        "live": True,
+        "stale": False,
+        "fetched_at": "2026-09-18T11:55:00Z",
+        "windows": [{"id": "weekly", "used": 7.0, "limit": 100}],
+    }
+
+    assert refresh_muse_quota.mark_sidecar_stale(payload, "signed out", now)
+
+    stored = json.loads(sidecar.read_text())
+    assert stored["ok"] is True
+    assert stored["live"] is False
+    assert stored["stale"] is True
+    assert stored["refresh_error"] == "signed out"
+    assert payload["stale"] is False
