+def mark_sidecar_stale(payload: dict, reason: str, now: datetime) -> bool:
+    """Invalidate a reading immediately when its browser source cannot refresh."""
+    stale = dict(payload)
+    stale["live"] = False
+    stale["stale"] = True
+    stale["refresh_error"] = reason
+    stale["checked_at"] = now.isoformat(timespec="seconds")
+    temporary = SIDECAR.with_suffix(".json.tmp")
+    try:
+        temporary.write_text(json.dumps(stale, indent=2) + "\n", encoding="utf-8")
+        temporary.replace(SIDECAR)
+    except OSError:
+        try:
+            temporary.unlink(missing_ok=True)
+        except OSError:
+            pass
+        return False
+    return True
+
