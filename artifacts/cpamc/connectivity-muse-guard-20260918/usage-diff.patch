+def click_page_control(ws_url: str, label: str, selector: str) -> bool:
+    """Click one exact visible-label/aria-label control through the existing tab."""
+    expression = f"""
+(() => {{
+  const wanted = {json.dumps(label.casefold())};
+  const element = [...document.querySelectorAll({json.dumps(selector)})].find((item) => {{
+    const text = (item.innerText || item.getAttribute('aria-label') || '').trim().toLowerCase();
+    return text === wanted;
+  }});
+  if (!element) return false;
+  element.click();
+  return true;
+}})()
+"""
+    return runtime_evaluate(ws_url, expression) is True
+
