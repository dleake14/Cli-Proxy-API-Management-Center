+def record_sidecar(*, db_path=None, now: datetime | None = None) -> int:
+    """Record the sidecar's windows into the quota store from its native owner.
+
+    The Windows CDP scrape writes data/muse-usage.json but cannot write the
+    SQLite store (it fails with "database is locked" over the WSL UNC path), so
+    the WSL-side owner records the reading. Idempotent per fetched_at: reruns
+    with the same scrape add nothing.
+    """
+    payload = _from_sidecar(now=now)
+    if payload is None:
+        return 0
+    fetched_at = str(payload.get("fetched_at") or "")
+    try:
+        store = QuotaStore(db_path=db_path)
+    except Exception:  # noqa: BLE001
+        return 0
+    newest: dict[str, str] = {}
+    for row in store.latest_readings(provider="meta", limit_per_pair=1):
+        newest[str(row["window"])] = str(row["read_at"])
+    recorded = 0
+    for win in payload.get("windows") or []:
+        if not isinstance(win, dict):
+            continue
+        window_id = str(win.get("id") or "weekly")
+        used = win.get("used")
+        if used is None and win.get("remaining") is not None:
+            used = 100.0 - float(win["remaining"])
+        if used is None:
+            continue
+        value = float(used)
+        if value < 0.0 or value > 100.0:
+            continue
+        if newest.get(window_id) == fetched_at:
+            continue
+        store.record(
+            "meta",
+            window=window_id,
+            used=value,
+            method="browser",
+            note=f"usg2 CDP meta {window_id} used_pct",
+            source_ref="usg2-cdp",
+            read_at=fetched_at or None,
+        )
+        recorded += 1
+    return recorded
+
+
